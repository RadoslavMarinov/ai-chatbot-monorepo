{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start":{
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env":[
        "GEMINI_AI_BASE_URL",
        "GEMINI_AI_API_KEY",
        "ALPHA_VANTAGE_API_BASE_URL",
        "ALPHA_VANTAGE_API_KEY",
        "GITHUB_AI_BASE_URL",
        "GITHUB_AI_TOKEN",
        "OLLAMA_API_BASE_URL",
        "OLLAMA_API_KEY",
        "GEMINI_AI_API_KEYS"
      ]
    }
  }
}
